{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TD Launcher Plus",
  "version": "3.0.0",
  "identifier": "xyz.functionstore.td-launcher-plus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TD Launcher Plus",
        "width": 640,
        "height": 700,
        "minWidth": 560,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "visible": false,
        "backgroundColor": [26, 26, 30, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/toeexpand"
    ],
    "fileAssociations": [
      {
        "ext": ["toe"],
        "name": "TouchDesigner Project",
        "description": "TouchDesigner Project File",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {}
}
